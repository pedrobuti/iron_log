# IronLog — variáveis de ambiente
# Copie para .env.local (não versionado) e preencha caso use o Supabase.
# Sem estas variáveis o app funciona em MODO LOCAL (localStorage) sem sincronização.

# URL do projeto Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Chave PÚBLICA: "Publishable key" (sb_publishable_...) ou "anon" legada (JWT com role anon).
# NUNCA use a chave secreta (sb_secret_... / service_role): o navegador a rejeita e ela daria acesso total ao banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Com o Supabase configurado, a conta é OBRIGATÓRIA por padrão.
# Defina como "true" para voltar a oferecer "Usar modo local neste dispositivo" na tela de login.
NEXT_PUBLIC_ALLOW_LOCAL_MODE=

# ── Notificações de fim de descanso com a tela bloqueada (Web Push) ──
# Gere o par de chaves uma única vez com: npm run vapid
# A chave PÚBLICA vai ao navegador; a PRIVADA fica só no servidor (Vercel → Environment Variables).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do responsável, exigido pelo protocolo (mailto: ou https://).
VAPID_SUBJECT=mailto:voce@exemplo.com
